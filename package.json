{
  "name": "litedbmodel-gen",
  "version": "1.0.8",
  "description": "embedoc-based model code generator for litedbmodel — generates TypeScript column definitions from SQL DDL (PostgreSQL/MySQL/SQLite)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "litedbmodel-gen": "dist/litedbmodel-gen.bundle.mjs"
  },
  "files": [
    "dist/litedbmodel-gen.bundle.mjs",
    "dist/litedbmodel-gen.bundle.mjs.map",
    "dist",
    "templates",
    "docs",
    "cli-contract.yaml"
  ],
  "scripts": {
    "build": "tsup",
    "bundle": "node esbuild.bundle.mjs",
    "bundle:min": "node esbuild.bundle.mjs --minify",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run bundle:min && npm run test:ci",
    "cli:generate": "cli-contracts generate",
    "dsl:generate": "agent-runtime generate --config dsl/agent-runtime.config.yaml",
    "test:ci": "vitest run",
    "audit:signatures": "npx --yes npm@11.19.1 audit signatures"
  },
  "keywords": [
    "litedbmodel",
    "embedoc",
    "code-generator",
    "orm",
    "postgresql",
    "mysql",
    "sqlite",
    "ddl",
    "schema"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foo-ogawa/litedbmodel-gen.git"
  },
  "peerDependencies": {
    "embedoc": ">=0.14.10",
    "litedbmodel": "^2.2.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "agent-contracts-runtime": "^0.36.18",
    "cli-contracts": "^0.34.12",
    "commander": "^14.0.3",
    "embedoc": "^0.14.10",
    "esbuild": "^0.28.2",
    "js-yaml": "^4.3.2",
    "node-sql-parser": "^5.4.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12",
    "zod": "^4.6.7"
  },
  "overrides": {
    "esbuild": "$esbuild"
  }
}
